{
  "name": "myknowledge-desktop",
  "version": "0.7.5",
  "private": true,
  "description": "MyKnowledge macOS 桌面壳（Electron）",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "start:dev": "MYKNOWLEDGE_DEV_BACKEND_URL=http://127.0.0.1:8080 electron .",
    "build:backend": "../scripts/build-backend.sh",
    "build:app": "ELECTRON_BUILDER_BINARIES_MIRROR=${ELECTRON_BUILDER_BINARIES_MIRROR:-https://npmmirror.com/mirrors/electron-builder-binaries/} electron-builder --mac",
    "release": "npm run build:backend && npm run build:app"
  },
  "devDependencies": {
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3"
  }
}
