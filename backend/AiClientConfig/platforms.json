{
  "_comment": "AI 客户端平台 → 各操作系统下的配置文件路径（单一来源）。平台 key 用 PascalCase，与 client_config.PLATFORMS 及前端 store.clientPlatforms 严格一致。路径占位符：~ → Path.home()，%APPDATA% / %USERPROFILE% → 对应环境变量。mcp_only=true 表示该平台仅支持 MCP（无 hooks / 专用 Agent）。cli_names 用于 client_installed 检测（PATH 探测）。",
  "os_order": ["macos", "windows", "linux"],
  "platforms": {
    "ClaudeCode": {
      "display": "Claude Code",
      "mcp_only": false,
      "cli_names": { "macos": "claude", "windows": "claude.exe", "linux": "claude" },
      "paths": {
        "macos": {
          "config_dir": "~/.claude",
          "mcp_file": "~/.claude.json",
          "settings_file": "~/.claude/settings.json",
          "agents_dir": "~/.claude/agents"
        },
        "windows": {
          "config_dir": "%USERPROFILE%/.claude",
          "mcp_file": "%USERPROFILE%/.claude.json",
          "settings_file": "%USERPROFILE%/.claude/settings.json",
          "agents_dir": "%USERPROFILE%/.claude/agents"
        },
        "linux": {
          "config_dir": "~/.claude",
          "mcp_file": "~/.claude.json",
          "settings_file": "~/.claude/settings.json",
          "agents_dir": "~/.claude/agents"
        }
      }
    },
    "ClaudeDesktop": {
      "display": "Claude Desktop",
      "mcp_only": true,
      "cli_names": {},
      "paths": {
        "macos": {
          "config_dir": "~/Library/Application Support/Claude",
          "mcp_file": "~/Library/Application Support/Claude/claude_desktop_config.json"
        },
        "windows": {
          "config_dir": "%APPDATA%/Claude",
          "mcp_file": "%APPDATA%/Claude/claude_desktop_config.json"
        },
        "linux": {
          "config_dir": "~/.config/Claude",
          "mcp_file": "~/.config/Claude/claude_desktop_config.json"
        }
      }
    },
    "CodeBuddyIDE": {
      "display": "CodeBuddy IDE",
      "mcp_only": false,
      "cli_names": {},
      "paths": {
        "macos": {
          "config_dir": "~/.codebuddy",
          "mcp_file": "~/.codebuddy/mcp.json",
          "settings_file": "~/.codebuddy/settings.json",
          "agents_dir": "~/.codebuddy/agents"
        }
      }
    },
    "WorkBuddy": {
      "display": "WorkBuddy",
      "mcp_only": false,
      "cli_names": {},
      "paths": {
        "macos": {
          "config_dir": "~/.workbuddy",
          "mcp_file": "~/.workbuddy/mcp.json",
          "settings_file": "~/.workbuddy/settings.json",
          "agents_dir": "~/.workbuddy/agents"
        }
      }
    }
  }
}
